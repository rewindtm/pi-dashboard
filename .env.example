# Copia questo file in .env e imposta un token segreto forte
DASHBOARD_TOKEN=change-me-to-a-long-random-secret
PORT=7890

# Cartella dove vengono clonate le repo GitHub gestite dalla dashboard (opzionale)
# APPS_ROOT=/home/pi/pi-dashboard-apps

# Percorso del file di configurazione di cloudflared (opzionale, default /etc/cloudflared/config.yml)
# CLOUDFLARED_CONFIG=/etc/cloudflared/config.yml

# Token API Cloudflare (Zone:DNS:Edit su tutte le zone gestite) per creare i record DNS
# dei tunnel via API invece che con `cloudflared tunnel route dns`, che è limitato alla
# singola zona autorizzata dal certificato locale di cloudflared. Senza questo token, i
# tunnel su domini diversi da quello del certificato locale non vengono creati correttamente.
# CLOUDFLARE_API_TOKEN=
